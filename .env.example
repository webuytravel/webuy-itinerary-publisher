# 可选 —— 只有 lib/existence_check.py 用得到,主管线不引用它。
# 不建 .env 也能跑完整个流程,详见 docs/SETUP.md。
#
# Skybear UAT 只读 MySQL 从库。账号按人发放,不是共享凭据,找 DBA 申请你自己的。
SKYBEAR_RO_MYSQL_HOST=
SKYBEAR_RO_MYSQL_PORT=3306
SKYBEAR_RO_MYSQL_USER=
SKYBEAR_RO_MYSQL_PASSWORD=
SKYBEAR_RO_MYSQL_DATABASE=webuy_tourt

# Skybear admin URL (UAT default; switch via --env=prod)
SKYBEAR_UAT_URL=https://test01.travel.webuy.ren
SKYBEAR_PROD_URL=https://travel.webuysg.com

# Public storefront for verification
WEBUYTRAVEL_URL=https://www.webuytravel.sg

# --- 图源 key:本项目不需要配 ---
# 找图走的是已部署的 webuy-itinerary-mcp,Gemini/Unsplash/Pexels 的 key 全在
# 服务端(见 docs/DESIGN.md 第 3 节)。下面这几个只在绕开该服务、直连图库时
# 才有意义,正常流程留空即可。
#
# --- Image sourcing (optional; the web fallback degrades without them) ---
# With none of these set, only Wikimedia Commons is reachable. Commons is a
# documentary archive: a launch-sample run got mineral specimens for
# "Keketuohai", locator maps for "Urumqi" and a road sign for "Urho Ghost
# City" — 4 of 48 candidates were usable. These keys are what make the web
# fallback produce brochure-grade photos. Same keys as the sibling
# webuy-itinerary-creation service (Render dashboard → webuy-itinerary-mcp).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
SHUTTERSTOCK_TOKEN=
